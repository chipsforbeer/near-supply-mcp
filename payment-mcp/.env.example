# Supply server (supplier-inventory-mcp). Local docker demo: http://127.0.0.1:8790
SUPPLY_URL=http://127.0.0.1:8790
# Only used by `npm run login` (copied to the clipboard for the sign-in page). Use a key WITHOUT approve.
SUPPLY_API_KEY=sik_...
# NEAR. testnet = public rail; mainnet = confidential rail (RAIL=public to pay publicly on mainnet)
NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# testnet payer
PAYER_ACCOUNT=yourpayer.testnet
PAYER_PRIVATE_KEY=ed25519:...
# mainnet payer (separate variables, so one network never signs with the other's key)
MAINNET_PAYER_ACCOUNT=yourpayer.near
MAINNET_PAYER_PRIVATE_KEY=ed25519:...
# 1Click partner key for the confidential rail: partners.near-intents.org, key type "1Click API"
ONECLICK_API_KEY=
# Limits, in the PO currency
PER_PAYMENT_CAP=50
DAILY_CAP=100
